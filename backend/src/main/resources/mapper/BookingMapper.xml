<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.dao.BookingDao">
    <resultMap id="BookingResultMap" type="com.hotel.entity.Booking">
        <id property="id" column="id"/>
        <result property="roomId" column="room_id"/>
        <result property="guestId" column="guest_id"/>
        <result property="checkIn" column="check_in"/>
        <result property="checkOut" column="check_out"/>
        <result property="status" column="status"/>
        <result property="totalAmount" column="total_amount"/>
        <association property="room" javaType="com.hotel.entity.Room" column="room_id" select="com.hotel.dao.RoomDao.getRoomById"/>
        <association property="guest" javaType="com.hotel.entity.Guest" column="guest_id" select="com.hotel.dao.GuestDao.getGuestById"/>
    </resultMap>

    <insert id="createBooking" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bookings (room_id, guest_id, check_in, check_out, status, total_amount)
        VALUES (#{roomId}, #{guestId}, #{checkIn}, #{checkOut}, #{status}, #{totalAmount})
    </insert>

    <select id="getAllBookings" resultMap="BookingResultMap">
        SELECT * FROM bookings
    </select>

    <update id="updateBooking">
        UPDATE bookings
        SET room_id = #{roomId}, guest_id = #{guestId}, check_in = #{checkIn}, 
            check_out = #{checkOut}, status = #{status}, total_amount = #{totalAmount}
        WHERE id = #{id}
    </update>

    <delete id="deleteBooking">
        DELETE FROM bookings WHERE id = #{id}
    </delete>
</mapper>
